<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_actions_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Top search/prompt pill bar (opens composer on click) -->
    <LinearLayout
        android:id="@+id/widget_prompt_input_bar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="OpenCode AI"
            android:src="@drawable/ic_widget_sparkle" />

        <TextView
            android:id="@+id/widget_prompt_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Сообщение в OpenCode…"
            android:textColor="#A1A1AA"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Go"
            android:src="@drawable/ic_widget_arrow" />
    </LinearLayout>

    <!-- Bottom row of 4 action buttons (Voice, Code, Terminal, Files) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_action_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Voice Input"
                android:src="@drawable/ic_widget_waveform" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_action_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="New Code Session"
                android:src="@drawable/ic_widget_code" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_action_term"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Terminal"
                android:src="@drawable/ic_widget_terminal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_action_files"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Files"
                android:src="@drawable/ic_widget_folder" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
