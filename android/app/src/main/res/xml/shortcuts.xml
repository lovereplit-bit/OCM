<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_settings_shortcut"
        android:shortcutShortLabel="@string/shortcut_settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="dev.opencode.mobile.SettingsActivity"
            android:targetPackage="dev.opencode.mobile" />
    </shortcut>
    <shortcut
        android:shortcutId="restart"
        android:enabled="true"
        android:icon="@drawable/ic_reload_shortcut"
        android:shortcutShortLabel="@string/shortcut_restart">
        <intent
            android:action="dev.opencode.mobile.RESTART"
            android:targetClass="dev.opencode.mobile.MainActivity"
            android:targetPackage="dev.opencode.mobile" />
    </shortcut>
</shortcuts>
