#!/bin/sh
# Creates and manages home-screen widgets of the app itself.
#   android-widget set <name> <title> [text] [--url <address>] [--no-pin]
#                      [--file <path - html|css|js|svg|png|jpeg|webp|gif>] [--w N] [--h N]
#   android-widget remove <name>
#   android-widget list
# --file replaces the plain title/text with rich content drawn as a picture:
#   *.html (may embed CSS and JS and define widgetTap() to animate on tap), *.svg or a raster picture.
#   Size is `[w]x[h]` render pixels (default 512x384); the pages must be self-contained.
# "set" with a name that exists updates the widget, so one command keeps it fresh.
. /usr/local/lib/opencode-android/bridge.sh

usage() {
  echo "usage: android-widget set <name> <title> [text] [--url <address>] [--no-pin] [--file <path>] [--w N] [--h N] | remove <name> | list" >&2
  exit 64
}

cmd="${1:-}"
[ -n "$cmd" ] && shift

case "$cmd" in
  set)
    name="${1:-}"
    title="${2:-}"
    [ -z "$name" ] && usage
    [ $# -gt 0 ] && shift
    [ $# -gt 0 ] && shift
    text=""
    url=""
    pin=1
    file=""
    w=""
    h=""

    while [ $# -gt 0 ]; do
      case "$1" in
        --url) url="${2:-}"; shift 2 || usage ;;
        --no-pin) pin=0; shift ;;
        --file)
          file="${2:-}"
          [ -n "$file" ] && [ -f "$file" ] || usage
          shift 2 || usage
          ;;
        --w)
          case "${2:-}" in ''|*[!0-9]*) usage ;; esac
          [ "$2" -ge 64 ] && [ "$2" -le 1280 ] || usage
          w="$2"; shift 2 || usage
          ;;
        --h)
          case "${2:-}" in ''|*[!0-9]*) usage ;; esac
          [ "$2" -ge 64 ] && [ "$2" -le 1280 ] || usage
          h="$2"; shift 2 || usage
          ;;
        *) if [ -z "$text" ]; then text="$1"; shift; else usage; fi ;;
      esac
    done

    set -- \
      --data-urlencode "name=$name" \
      --data-urlencode "title=$title" \
      --data-urlencode "text=$text" \
      --data-urlencode "url=$url" \
      --data-urlencode "pin=$pin"

    if [ -n "$file" ]; then
      # Base64 of the file rides in a temp file so long sources stay inside the argument budget.
      src="$(mktemp)"
      base64 "$file" | tr -d '\n' > "$src" || usage
      set -- "$@" --data-urlencode "src_b64@${src}"
      [ -n "$w" ] && set -- "$@" --data-urlencode "w=$w"
      [ -n "$h" ] && set -- "$@" --data-urlencode "h=$h"
    fi

    bridge /widget/set "$@"
    status=$?
    [ -n "$file" ] && rm -f "${src:-}"
    exit $status
    ;;
  remove)
    [ -z "${1:-}" ] && usage
    bridge /widget/remove --get --data-urlencode "name=$1"
    ;;
  list)
    bridge /widget/list
    ;;
  *)
    usage
    ;;
esac
