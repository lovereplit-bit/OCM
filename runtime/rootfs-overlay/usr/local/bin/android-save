#!/bin/sh
# Copies a file to the phone's Download folder (/storage/emulated/0/Download).
#
#   android-save report.pdf
#   android-save build/app.zip my-app.zip
. /usr/local/lib/opencode-android/bridge.sh

file="${1:-}"

if [ -z "$file" ]; then
  echo "usage: android-save <file> [name in Download]" >&2
  exit 64
fi

if [ ! -f "$file" ]; then
  echo "android-save: not a regular file: $file" >&2
  exit 66
fi

full="$(readlink -f "$file")"
name="${2:-$(basename "$full")}"

if out="$(bridge /save --get --data-urlencode "path=$full" --data-urlencode "name=$name")"; then
  echo "Saved: /storage/emulated/0/${out}"
else
  echo "android-save: $out" >&2
  exit 1
fi
