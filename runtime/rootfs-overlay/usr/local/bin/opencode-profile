#!/usr/bin/env bash
# opencode-profile: run the official opencode CLI as an isolated user profile.
# Lives inside the Debian proot rootfs, e.g. /usr/local/bin/opencode-profile.
#
#   opencode-profile <profile> [opencode args...]
#   opencode-profile alice serve --hostname 127.0.0.1 --port 4096
#
# Each profile gets its own HOME and XDG dirs, so login (auth.json), sessions,
# config and the free-usage identity are per user, like a separate Termux install.
# Nothing else is injected: no gateway, no base-URL override, and no API key
# unless the profile itself has an "api-key" file (chmod 600).
set -euo pipefail

profile="${1:-}"
if [[ ! "$profile" =~ ^[A-Za-z0-9_-]{1,32}$ ]]; then
  echo "usage: opencode-profile <profile: 1-32 chars [A-Za-z0-9_-]> [opencode args...]" >&2
  exit 2
fi
shift

root="${OCM_PROFILES_DIR:-/var/lib/ocm/profiles}/$profile"
mkdir -p "$root"/{home,config,data,state,cache}

export HOME="$root/home"
export XDG_CONFIG_HOME="$root/config"
export XDG_DATA_HOME="$root/data"
export XDG_STATE_HOME="$root/state"
export XDG_CACHE_HOME="$root/cache"

# A key inherited from the app's environment must not leak into a profile.
unset OPENCODE_API_KEY
if [[ -s "$root/api-key" ]]; then
  OPENCODE_API_KEY="$(<"$root/api-key")"
  export OPENCODE_API_KEY
fi

exec opencode "$@"
